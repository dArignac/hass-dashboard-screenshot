# -----------------------------------------------------------------------------
# Home Assistant Dashboard Screenshot Service Configuration
# -----------------------------------------------------------------------------

# [Required] The base URL of your Home Assistant instance (e.g., http://homeassistant.local:8123)
HA_URL=http://homeassistant.local:8123

# [Required] Long-Lived Access Token generated in Home Assistant (Profile -> Long-Lived Access Tokens)
HA_TOKEN=your_long_lived_access_token_here

# [Optional] Path to the target dashboard and view (Default: lovelace/0)
DASHBOARD_PATH=lovelace/0

# [Optional] Browser viewport dimensions in pixels (Default: 1920x1080)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# [Optional] Interval between background captures in seconds (Default: 60)
SCREENSHOT_INTERVAL_SECONDS=60

# [Optional] Seconds to wait after page load for cards/WebSockets to stabilize before snapping (Default: 3)
RENDER_DELAY_SECONDS=3

# [Optional] Port on which the HTTP server will listen inside the container (Default: 8080)
PORT=8080

# [Optional] Host address to bind the HTTP server to (Default: 0.0.0.0)
HOST=0.0.0.0

# [Optional] Whether to hide Home Assistant top header and sidebar via injected CSS (Default: true)
HIDE_HEADER_AND_SIDEBAR=true

# [Optional] Image format to capture and serve: png or jpeg (Default: png)
IMAGE_FORMAT=png
